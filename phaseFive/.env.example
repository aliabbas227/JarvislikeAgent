# Where the persistent vector store lives on disk. Relative paths are
# relative to wherever you run memory_chat.py from — an absolute path
# under A:\PROJECTS\JARVIS\phaseFive\ is safer if you'll ever run it
# from a different working directory. Confirmed by real-world
# incident, not just theory: the relative default below actually
# caused "0 memories stored" once memory_chat.py started being invoked
# from outside phaseFive\ (Phase 7's orchestrator.py, and running this
# very file with a different cwd) — python-dotenv's relative-to-cwd
# resolution combined with a relative CHROMA_DB_PATH silently pointed
# at a different, empty store each time. Use an absolute path.
CHROMA_DB_PATH=A:\PROJECTS\JARVIS\phaseFive\chroma_store

# Chroma collection name. Only matters if you want multiple separate
# memory sets (e.g. testing vs. real) without wiping each other.
MEMORY_COLLECTION=jarvis_memories

# How many memories search_memories() returns by default when called
# without an explicit n_results (memory.py).
MEMORY_RESULTS=5

# How many retrieved memories memory_chat.py considers per turn. No
# distance-based relevance filter is applied on top of this (see
# README — an earlier attempt at one silently dropped valid matches).
RECALL_MAX_RESULTS=5

# Distance below which a new "remember"-d fact is treated as the same
# fact restated (typo fix, rewording) and updates the existing memory
# in place instead of storing a duplicate. Tight by design — this is
# not the same kind of threshold as a relevance filter, see README.
DEDUP_DISTANCE_THRESHOLD=0.05

# --- Phase 1 settings (memory_chat.py imports jarvis.py, so these
# apply too — see phaseOne/.env.example for the full set) ---
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1:8b
