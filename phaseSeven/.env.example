# --- Phase 1 (LLM) ---
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1:8b
# ANTHROPIC_API_KEY=

# --- Phase 2 (voice I/O) ---
SAMPLE_RATE=16000
SILENCE_THRESHOLD=150
SILENCE_DURATION=1.5
MAX_RECORD_SECONDS=30
WHISPER_MODEL=base
# WHISPER_LANGUAGE=          # leave unset for auto-detect
# TTS_RATE=

# --- Phase 3 (wake word) ---
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5

# --- Phase 7 (orchestration) ---
# Seconds after a wake-word trigger before it can fire again. Separate
# from the WAKE_THRESHOLD/model itself, and left independently
# tunable in case a full turn's own audio (e.g. Jarvis's own TTS
# output being picked back up) needs a longer cooldown than Phase 3's
# standalone demo did.
WAKE_COOLDOWN_SECONDS=2.0

# How many audio callbacks to discard right after (re)opening the
# wake-word stream, before scoring resumes. Found via manual testing:
# restarting the gate between turns could register a spurious wake
# almost immediately (most likely a transient in the freshly opened
# stream's first callback(s)). Raise this if a spurious wake still
# slips through in practice; ~4 (the default, ~320ms at 80ms/frame) is
# short enough that saying the wake word right after a turn ends still
# works.
WAKE_STARTUP_SKIP_FRAMES=4

# Real pause (seconds) before reopening the wake-word stream, skipped
# on the very first start() of the process. Confirmed via diagnostic
# logging that WAKE_STARTUP_SKIP_FRAMES alone wasn't always enough: a
# spurious wake fired with a genuinely high confidence score at the
# very first scored frame after restart, pointing at stale audio
# bleeding in from whichever stream (the turn recorder's, or the
# wake-word gate's own) had just closed on the same device. Raise this
# first if a spurious wake still slips through in practice -- it
# addresses the root cause more directly than the frame-skip does.
WAKE_RESTART_SETTLE_SECONDS=0.3

# Short chime played right after wake-word detection, before recording
# starts -- lets you know Jarvis heard you without having to guess.
# Windows-only (winsound); no-ops elsewhere. Set to false to disable.
WAKE_CHIME_ENABLED=true

# Follow-up window: after Jarvis replies, keep listening for a bit
# without needing the wake word again -- lets you have a quick
# back-and-forth. FOLLOWUP_LISTEN_SECONDS is how long it waits for you
# to START talking before giving up and falling back to full
# wake-word listening -- once you actually start, the normal
# MAX_RECORD_SECONDS/silence-based cutoff takes over instead, same as
# any other turn, so starting to talk near the end of this window
# doesn't cut you off mid-sentence. Set FOLLOWUP_ENABLED=false to
# always require the wake word for every turn instead.
FOLLOWUP_LISTEN_SECONDS=6.0
FOLLOWUP_ENABLED=true

# How many tool-call round-trips a single turn can make before giving
# up. Raised from Phase 4's original 4 to Phase 6's 8 (reused here) --
# multi-step UI tasks (open an app, check focus, type, press a hotkey,
# check again...) routinely need more than 4 even when everything's
# working correctly.
MAX_TOOL_HOPS=8

# Long text fields (screen OCR output, file contents) get truncated to
# this many characters before being written to the log -- the model
# still gets the full, untruncated result, only the log is affected.
LOG_TEXT_TRUNCATE_CHARS=300


# --- Phase 4 (milestone 2 -- tool-calling LLM) ---
# DeepSeek -- https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Tavily (web search tool) -- free tier, no card required: https://tavily.com
TAVILY_API_KEY=your_key_here

# --- Phase 5 (milestone 3 -- persistent memory) ---
# All read directly by phaseFive/memory.py and memory_chat.py, reused
# as-is -- see phaseFive/.env.example for the full explanation of each.
# Left commented here: every one of these already has a sensible
# default, and CHROMA_DB_PATH's default deliberately anchors to
# memory.py's own file location (phaseFive/chroma_store), not this
# process's cwd -- so the orchestrator shares the SAME memory store
# Phase 5's own memory_chat.py CLI reads/writes, on purpose. Uncomment
# CHROMA_DB_PATH only if you want the orchestrator's memories kept
# separate from memory_chat.py's.
# CHROMA_DB_PATH=
# MEMORY_COLLECTION=jarvis_memories
# MEMORY_RESULTS=5
# RECALL_MAX_RESULTS=5
# DEDUP_DISTANCE_THRESHOLD=0.05

# --- Phase 6 (milestone 4 -- OS-control confirmation gate) ---
# Optional but STRONGLY recommended. If set, confirming a destructive
# action (delete_file, write_file(overwrite=true), click, press_hotkey)
# requires typing this exact password at the terminal (hidden input)
# instead of just "yes" -- matters even more here than it did for Phase
# 6's typed-only CLI, since voice input can now be the thing proposing
# the action. If left unset, falls back to a plain yes/no prompt and
# logs a loud warning on every startup so that weaker mode is never
# silent.
CONFIRM_PASSWORD=choose-a-password-here

# Optional. Only needed if the Tesseract OCR binary (required by
# read_screen) isn't already on your PATH after installing it
# separately -- see phaseSix/README.md for the install step. Full path
# to tesseract.exe.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional. Delay in seconds between each key-down/key-up when sending
# a hotkey (press_hotkey). Default 0.05 was confirmed necessary for
# system-level shortcuts like Alt+F4 to register correctly -- see
# phaseSix/README.md's "Mouse / keyboard automation" section.
HOTKEY_KEY_DELAY_SECONDS=0.05