# os_agent.py reuses Phase 4's llm_client.py, which reads these same
# variables. Copy phaseFour/.env's values here, or just make sure
# phaseFour/.env is populated — either works since llm_client.py reads
# from the environment, not a hardcoded phaseFour path for the key.
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional but recommended. If set, confirming a destructive action
# (delete_file, or write_file with overwrite=true) requires typing this
# exact password at the terminal (hidden input) instead of just "yes".
# If left unset, os_agent.py falls back to a plain yes/no prompt and
# logs a warning every startup so the weaker mode is never silent.
CONFIRM_PASSWORD=choose-a-password-here

# Optional. Only needed if the Tesseract OCR binary (required by
# read_screen) isn't already on your PATH after installing it — see
# README.md for the install step itself. Full path to tesseract.exe.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional. Delay in seconds between each key-down/key-up when sending a
# hotkey (press_hotkey). Default 0.05 was confirmed necessary for
# system-level shortcuts like Alt+F4 to register correctly — see
# README.md's "Mouse / keyboard automation" section. Only raise this if
# 0.05 still isn't reliable on your machine.
HOTKEY_KEY_DELAY_SECONDS=0.05
