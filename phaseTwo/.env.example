# Whisper model size: tiny, base, small, medium, large
# "base" is a good starting point — fast, reasonably accurate, small download.
WHISPER_MODEL=base

# pyttsx3 speaking rate in words/minute. Leave unset to use the system default.
TTS_RATE=175

# Microphone capture settings
SAMPLE_RATE=16000
SILENCE_THRESHOLD=500
SILENCE_DURATION=1.5
MAX_RECORD_SECONDS=30
